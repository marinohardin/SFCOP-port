+++ b/runtime/win32hle/host_lite.c
@@ -233,11 +233,80 @@ void hle_preempt(void) {
 /* ------------------------------------------------------------- dispatch
  * recomp_lookup searches the generated dispatch table (declared extern in
  * recomp_types.h; defined by the lifted program, or the selftest). */
+/* That table, or the copy hle_dispatch_fold made of it with a host's entries
+ * written in.
+ *
+ * Every indirect call asks recomp_lookup, so a direct-mapped cache sits in
+ * front of the binary search. A slot is one 64-bit word, read and written
+ * whole, so a reader never sees half of one answer: the VA in the high half,
+ * and in the low half 0 for an empty slot, DISPATCH_ABSENT for a VA the table
+ * does not hold, or the table index + 1. A miss is cached too: an import's VA
+ * is never in the table, and imports are called most of all. The table changes
+ * only in hle_dispatch_fold, which empties the cache, so an answer, once
+ * cached, stays right. The fold is for start-up only, before any guest thread
+ * runs: a lookup on another thread during a fold could pair a slot written
+ * against the old table with the new one. */
+#define DISPATCH_CACHE_BITS 14
+#define DISPATCH_ABSENT     0xFFFFFFFFu
+static uint64_t g_dispatch_cache[1u << DISPATCH_CACHE_BITS];
+static const recomp_dispatch_entry_t *g_dispatch;   /* NULL: the generated table */
+static uint32_t g_dispatch_n;
+
+static const recomp_dispatch_entry_t *dispatch_find(uint32_t va);
+
 recomp_func_t recomp_lookup(uint32_t va) {
-    uint32_t lo = 0, hi = recomp_dispatch_count;
+    const recomp_dispatch_entry_t *t = g_dispatch ? g_dispatch : recomp_dispatch_table;
+    uint64_t *slot = &g_dispatch_cache[(va * 0x9E3779B1u) >> (32 - DISPATCH_CACHE_BITS)];
+    uint64_t e = __atomic_load_n(slot, __ATOMIC_RELAXED);
+    if ((uint32_t)(e >> 32) == va && (uint32_t)e != 0)
+        return (uint32_t)e == DISPATCH_ABSENT ? NULL : t[(uint32_t)e - 1].func;
+    const recomp_dispatch_entry_t *found = dispatch_find(va);
+    uint32_t index = found ? (uint32_t)(found - t) + 1 : DISPATCH_ABSENT;
+    __atomic_store_n(slot, ((uint64_t)va << 32) | index, __ATOMIC_RELAXED);
+    return found ? found->func : NULL;
+}
+
+static int dispatch_by_address(const void *a, const void *b) {
+    uint32_t x = ((const recomp_dispatch_entry_t *)a)->address;
+    uint32_t y = ((const recomp_dispatch_entry_t *)b)->address;
+    return x < y ? -1 : x > y;
+}
+
+/* win32hle.h: a host's entries into a copy of the table. Merges two sorted
+ * lists; an entry of the host's at a VA the table holds takes its place. Then
+ * indirect calls ask the table before the manual hook (recomp_types.h,
+ * recomp_dispatch_folded). */
+int hle_dispatch_fold(const recomp_dispatch_entry_t *entries, uint32_t n) {
+    const recomp_dispatch_entry_t *t = g_dispatch ? g_dispatch : recomp_dispatch_table;
+    uint32_t tn = g_dispatch ? g_dispatch_n : recomp_dispatch_count;
+    recomp_dispatch_entry_t *add = malloc(sizeof *add * (n ? n : 1));
+    recomp_dispatch_entry_t *out = malloc(sizeof *out * (tn + n ? tn + n : 1));
+    if (!add || !out) hle_fatal("hle_dispatch_fold: out of memory");
+    if (n) memcpy(add, entries, sizeof *add * n);
+    qsort(add, n, sizeof *add, dispatch_by_address);
+    uint32_t i = 0, j = 0, k = 0;
+    int added = 0;
+    while (i < tn || j < n) {
+        if (j == n || (i < tn && t[i].address < add[j].address)) { out[k++] = t[i++]; continue; }
+        if (i < tn && t[i].address == add[j].address) i++; else added++;
+        out[k++] = add[j++];
+    }
+    free(add);
+    /* A previous copy is not freed: a fold is for start-up only, but a reader
+     * that still held the old table must never read freed memory. */
+    g_dispatch = out;
+    g_dispatch_n = k;
+    memset(g_dispatch_cache, 0, sizeof g_dispatch_cache);
+    recomp_dispatch_folded = 1;
+    return added;
+}
