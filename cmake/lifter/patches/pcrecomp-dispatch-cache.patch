+    const recomp_dispatch_entry_t *t = g_dispatch ? g_dispatch : recomp_dispatch_table;
+    uint32_t lo = 0, hi = g_dispatch ? g_dispatch_n : recomp_dispatch_count;
     while (lo < hi) {
-        uint32_t mid = lo + (hi - lo) / 2, m = recomp_dispatch_table[mid].address;
-        if (m == va) return recomp_dispatch_table[mid].func;
+        uint32_t mid = lo + (hi - lo) / 2, m = t[mid].address;
+        if (m == va) return &t[mid];
         if (m < va) lo = mid + 1; else hi = mid;
     }
     return NULL;
