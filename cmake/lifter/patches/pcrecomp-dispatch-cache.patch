+ * then on, indirect calls ask the table before the manual hook, so the hook
+ * must answer only VAs the table lacks (recomp_types.h,
+ * recomp_dispatch_folded). */
+int hle_dispatch_fold(const recomp_dispatch_entry_t *entries, uint32_t n);
