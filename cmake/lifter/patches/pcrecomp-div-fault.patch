--- a/runtime/recomp32/recomp_types.h
+++ b/runtime/recomp32/recomp_types.h
@@ -1282,6 +1282,17 @@
         RECOMP_REGS_OUT(); recomp_yield_hook(); RECOMP_REGS_IN(); \
     } } while (0)
 
+/* A zero divisor in div or idiv. The CPU raises #DE, which Windows delivers
+ * as EXCEPTION_INT_DIVIDE_BY_ZERO (0xC0000094) to the program's own handlers.
+ * A host that does the same sets this hook; it does not return when a handler
+ * takes the exception. Without a hook, or when it returns, the lifted code
+ * goes on with the result the lift gives a zero divisor (0). */
+RECOMP_WEAK void (*recomp_div_fault_hook)(uint32_t code);
+#define RECOMP_DIV_FAULT(code) do { \
+    if (recomp_div_fault_hook) { \
+        RECOMP_REGS_OUT(); recomp_div_fault_hook(code); RECOMP_REGS_IN(); \
+    } } while (0)
+
 /* Always-callable trace dump (no-op unless RECOMP_TRACE). */
 void recomp_dump_trace(const char* why);
 
