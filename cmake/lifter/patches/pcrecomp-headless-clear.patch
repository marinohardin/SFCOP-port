+                         (float)(argb & 0xFF) / 255.f, (float)(argb >> 24) / 255.f);
+        clear_rect(t, l, tp, r, b, flags, c, z);         /* and D3DCLEAR_ZBUFFER */
     }
     hle_dd_mark(t);
 }
