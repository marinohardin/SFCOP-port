+/* A host that moves control out of nested guest calls with a longjmp (guest
+ * exceptions: a catch further up the stack than a native -> guest call) skips
+ * the mach_leave of every hle_call_guest it jumps over. It reads the depth
+ * where it can land and puts it back when it lands; the thread holds the
+ * machine at both depths, so the mutex stays as it is. */
+int  hle_mach_depth(void) { return g_ms.depth; }
+void hle_mach_set_depth(int depth) { g_ms.depth = depth; }
 
