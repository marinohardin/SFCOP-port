+/*
+ * win32/posix.h -- the POSIX subset the win32hle runtime uses, on a Windows
+ * host (the MSVC C runtime and the Windows API underneath).
+ *
+ * The runtime is written against POSIX. On Windows the build includes this
+ * header first in every runtime file (-include win32/posix.h) and puts
+ * win32/include on the include path, whose unistd.h, pthread.h, dirent.h,
+ * sys/mman.h and the rest only bring this header in. Nothing here includes
+ * <windows.h>: the runtime names Win32's own types and constants for the
+ * guest, so the host's must stay out of its files. win32/posix.c holds the
+ * implementations; win32/net.h is the sockets part, for wsock32.c alone.
+ *
+ * Only what the runtime calls is here, with the semantics it relies on:
+ *   - files are binary (open adds O_BINARY), as on POSIX;
+ *   - threads are detached (pthread_create closes its handle; there is no
+ *     pthread_join), pthread_t is the thread id;
+ *   - mutexes are not recursive (SRW locks), conditions are condition
+ *     variables, once is InitOnce;
+ *   - mmap is anonymous memory only (a file view fails with ENODEV): a
+ *     reservation without access, and MAP_FIXED over part of one gives fresh
+ *     zero pages with the protection asked for, as on POSIX;
+ *   - paths are the C runtime's (ANSI); realpath and getcwd give forward
+ *     slashes;
+ *   - pread and pwrite leave the file pointer where it was, as on POSIX.
+ */
+#ifndef WIN32HLE_WIN32_POSIX_H
+#define WIN32HLE_WIN32_POSIX_H
+#ifdef _WIN32
+
+#ifndef _CRT_DECLARE_NONSTDC_NAMES
+#define _CRT_DECLARE_NONSTDC_NAMES 1   /* close, read, lseek... by their POSIX names */
+#endif
+#ifndef _CRT_SECURE_NO_WARNINGS
+#define _CRT_SECURE_NO_WARNINGS 1
+#endif
+#ifndef _CRT_NONSTDC_NO_WARNINGS
+#define _CRT_NONSTDC_NO_WARNINGS 1
+#endif
+
+#include <stdint.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <errno.h>
+#include <io.h>
+#include <direct.h>
+#include <process.h>
+#include <fcntl.h>
+#include <sys/types.h>
+#include <sys/stat.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef intptr_t ssize_t;
+typedef unsigned int useconds_t;
+
+/* ---- unistd.h ---- */
+#define R_OK 4
+#define W_OK 2
