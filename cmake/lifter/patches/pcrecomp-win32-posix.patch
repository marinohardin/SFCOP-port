+#define CLOCK_MONOTONIC 1
+int clock_gettime(clockid_t clock, struct timespec *ts);
+int nanosleep(const struct timespec *request, struct timespec *remain);
+static __inline struct tm *localtime_r(const time_t *t, struct tm *out) { return localtime_s(out, t) ? NULL : out; }
+static __inline struct tm *gmtime_r(const time_t *t, struct tm *out) { return gmtime_s(out, t) ? NULL : out; }
+#define timegm _mkgmtime
