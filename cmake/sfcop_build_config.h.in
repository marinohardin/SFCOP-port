// Generated by CMake from cmake/sfcop_build_config.h.in into the build directory. Never committed.
#pragma once

// A package build (SFCOP_PACKAGE_BUILD, scripts/dist.sh) leaves these empty; the client then finds
// what it needs beside itself (src/app/Bundle.h).

// The install the build lifted, and the build's writable copy of it (cmake/SfcopLifter.cmake).
#define SFCOP_INSTALL_DIR "@SFCOP_CONFIG_INSTALL_DIR@"
#define SFCOP_DEFAULT_GAME_DIR "@SFCOP_CONFIG_GAME_DIR@"

// The hash list the install is verified against (src/app/Install.h).
#define SFCOP_HASH_LIST "@SFCOP_CONFIG_HASH_LIST@"

// The source tree the client was built from: the replay oracle finds its trace tools and the
// commit it records there (src/app/oracle/OracleRun.h).
#define SFCOP_SOURCE_DIR "@SFCOP_CONFIG_SOURCE_DIR@"

// The release number (VERSION) and the commit the client was built from, for the start line of the
// important log (src/platform/Core/Log.h).
#define SFCOP_VERSION "@SFCOP_CONFIG_VERSION@"
#define SFCOP_BUILD_COMMIT "@SFCOP_CONFIG_COMMIT@"
