# The cross toolchains' pins (cmake/toolchains/README.md). Read by setup.sh (as shell) and by the
# toolchain files (as KEY=VALUE lines). One value per line, no quotes, no spaces around `=`.
# Every download is from its upstream's own release page or registry, pinned by version and
# SHA-256; a tree hash (sysroot.py tree-hash) pins what setup.sh installs from it.

# LLVM: clang, clang-cl, lld (ld.lld, lld-link), llvm-ar, llvm-rc; the official macOS arm64 release.
LLVM_VERSION=22.1.8
LLVM_URL=https://github.com/llvm/llvm-project/releases/download/llvmorg-22.1.8/LLVM-22.1.8-macOS-ARM64.tar.xz
LLVM_SHA256=f260f4f7c0d430828a81ae8a3826a1d63fc0963ec2459489308cc23b1f7eab4f
LLVM_SIZE=1479903744

# Linux sysroot: the Steam Runtime 3 "sniper" SDK sysroot (Debian 11 base, glibc 2.31, GCC 10),
# the baseline the SteamOS AppImage targets. Only its x86_64 headers and link libraries are kept.
LINUX_SYSROOT_VERSION=3.0.20261021.266025
LINUX_SYSROOT_URL=https://repo.steampowered.com/steamrt3/images/3.0.20261021.266025/com.valvesoftware.SteamRuntime.Sdk-amd64%2Ci386-sniper-sysroot.tar.gz
LINUX_SYSROOT_SHA256=8f71947035f97925a311b2ed753f22efcf2f13d6f1631945b8e537f8903ce2cf
LINUX_SYSROOT_SIZE=1234880637
LINUX_SYSROOT_TREE_SHA256=cd4278338b7b945c0fb241ffcfece8afbe8cf0d31c50cf43b58b2bdc87d75b55

# Windows sysroot: the MSVC CRT and the Windows SDK, x86_64, desktop, fetched from Microsoft's
# Visual Studio 17.14.44 installer manifest by xwin (run in the pinned Alpine image below).
# The owner accepted Microsoft's licence terms for them (README.md, "Licence").
WINDOWS_CRT_VERSION=14.44.17.14
WINDOWS_SDK_VERSION=10.0.26100
WINDOWS_VSMAN_VERSION=17.14.37827.9
WINDOWS_VSMAN_URL=https://download.visualstudio.microsoft.com/download/pr/6bd63d7f-1818-4e03-a552-9feb11496c19/4cc372d79f02e331c999a926b833a49eb74b30357d30f41ba9cffa1dc0369379/VisualStudio.vsman
WINDOWS_VSMAN_SHA256=4cc372d79f02e331c999a926b833a49eb74b30357d30f41ba9cffa1dc0369379
WINDOWS_VSMAN_SIZE=30443645
WINDOWS_SYSROOT_TREE_SHA256=2c33c03f3cf89fd09fe09e0c874cc771f129cfba0982ecacfec2b4e63656269a
XWIN_VERSION=0.10.0
XWIN_URL=https://github.com/Jake-Shadle/xwin/releases/download/0.10.0/xwin-0.10.0-aarch64-unknown-linux-musl.tar.gz
XWIN_SHA256=6d56d28537a86f37aa3d041318898f25ee3100c6b6ec332ad873c28faf37be23
XWIN_SIZE=3062263
XWIN_IMAGE=alpine:3.22@sha256:2e0b81d60597f449baa56dc25d355367869d2dca4cd57e866f1e2b52af3eb55f

# Linux arm64 sysroot (linux-arm64 preset, release packages only). The Steam Runtime 3 "sniper"
# has no arm64 build, so this is a Debian 12 "bookworm" arm64 sysroot (glibc 2.36, GCC 12's
# libstdc++): the pinned image installs the -dev packages from the Debian snapshot archive at the
# pinned time, and setup.sh keeps the headers and link libraries. The tree hash pins the result.
LINUX_ARM64_SYSROOT_IMAGE=debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
LINUX_ARM64_SYSROOT_SNAPSHOT=20261101T000000Z
LINUX_ARM64_SYSROOT_TREE_SHA256=d589ad63d7bac4e3609ac5f560ef872c6fbaf7fce7bc6a79ae8b72ee1e7de939

# Windows arm64 sysroot (windows-arm64 preset): the same MSVC CRT and Windows SDK as x64, from the
# same installer manifest and xwin, for aarch64.
WINDOWS_ARM64_SYSROOT_TREE_SHA256=c439b609c89e136e29ba8066803ba8e76f40211aca6836d3bc6d1edf47a74c7e

# The image the linux-x64 tests and boot run in (Debian 11, glibc 2.31, as the sysroot).
LINUX_RUN_IMAGE=debian:bullseye-slim@sha256:e5b6442dd2e9684cf5e87d8338b5968f3b348636fc0be6d7850a381e3731a2bd
# The image the linux-arm64 tests run in: the sysroot's own image (glibc 2.36), native on the Mac.
LINUX_ARM64_RUN_IMAGE=debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
