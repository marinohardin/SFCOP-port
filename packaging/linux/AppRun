#!/bin/sh
# The AppImage's entry point (packaging/README.md): starts usr/bin/sfcop with the image's own SDL
# libraries in usr/lib ahead of the system's. The client finds its hash list beside usr/bin/sfcop.
here=${APPDIR:-$(cd "$(dirname "$0")" && pwd -P)}
LD_LIBRARY_PATH="$here/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH
exec "$here/usr/bin/sfcop" "$@"
