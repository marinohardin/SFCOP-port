# The AppImage tools (packaging/linux/make_appimage.sh), each pinned by its release and SHA-256.
# fetch_appimage_tools.sh downloads them into SFCOP_APPIMAGE_TOOLS (default <tools>/appimage).
# appimagetool runs in the linux-arm64 run image (cmake/toolchains/pins.env), natively on the Mac;
# the type 2 runtime of the target architecture is what the AppImage starts with.
APPIMAGETOOL_VERSION=1.9.1
APPIMAGETOOL_URL=https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-aarch64.AppImage
APPIMAGETOOL_SHA256=f0837e7448a0c1e4e650a93bb3e85802546e60654ef287576f46c71c126a9158
APPIMAGE_RUNTIME_VERSION=20251108
APPIMAGE_RUNTIME_X86_64_URL=https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-x86_64
APPIMAGE_RUNTIME_X86_64_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d
APPIMAGE_RUNTIME_AARCH64_URL=https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-aarch64
APPIMAGE_RUNTIME_AARCH64_SHA256=00cbdfcf917cc6c0ff6d3347d59e0ca1f7f45a6df1a428a0d6d8a78664d87444
# appimagetool needs the `file` command, which the slim run image lacks: Debian 12's file and
# libmagic for arm64 (bookworm, 1:5.44-3), each pinned by the SHA-256 in Debian's package index.
FILE_DEB_VERSION=5.44-3
FILE_DEB_URL=https://deb.debian.org/debian/pool/main/f/file/file_5.44-3_arm64.deb
FILE_DEB_SHA256=de027231666482a8ae108f7f9c64711e08382b23476bb1f67979f9e3c39905c6
LIBMAGIC1_DEB_URL=https://deb.debian.org/debian/pool/main/f/file/libmagic1_5.44-3_arm64.deb
LIBMAGIC1_DEB_SHA256=2fbaa1e2efdb80cf20cb13b2c523e82602c117cf5ec922c6d1d4ce6e18440052
LIBMAGIC_MGC_DEB_URL=https://deb.debian.org/debian/pool/main/f/file/libmagic-mgc_5.44-3_arm64.deb
LIBMAGIC_MGC_DEB_SHA256=ff57ca94d3c1231b16d10587e60a2cf6c53b53249879235c59fa0b19e832974c
