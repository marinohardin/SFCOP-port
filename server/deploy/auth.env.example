# /etc/sfcop/auth.env: the auth stand-in's configuration (src/net/DIRECTORY_API.md, "Account
# login", "Version check"). Outside the repository, mode 640, owner root:sfcop. deploy.sh creates
# it from this file once. Plain KEY=VALUE lines (systemd's EnvironmentFile form).
#
# Accounts live in the process's memory only and a restart empties them: an interim answer under
# DESIGN §12.3, not a decision. The original protocol carries the new-account password in clear;
# players must use a throwaway password (server/auth/README.md).

# The account login and the profile search, on the original's ports.
SFCOP_LOGIN_LISTEN=0.0.0.0:29900
SFCOP_SEARCH_LISTEN=0.0.0.0:29901

# The version check, HTTP on port 80. If another process on this host holds port 80 (the lobby's
# TLS proxy does), set "off": the client reads a version check that does not answer as current.
SFCOP_PATCH_LISTEN=0.0.0.0:80

# The health endpoint for the host's monitor, never public.
SFCOP_HEALTH_LISTEN=127.0.0.1:47714

# What the host's monitor runs once when a health check starts failing; it may use
# $SFCOP_ALERT_MESSAGE. The owner's channel goes here and nowhere else.
#SFCOP_ALERT_COMMAND=curl -fsS -d "$SFCOP_ALERT_MESSAGE" https://ntfy.example.test/your-topic

# debug adds the email of each request; nothing else identifying is ever logged.
#SFCOP_LOG_LEVEL=info
