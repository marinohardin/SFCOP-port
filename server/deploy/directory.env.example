# /etc/sfcop/directory.env: the directory stand-in's configuration (src/net/DIRECTORY_API.md,
# "Directory"). Outside the repository, mode 640, owner root:sfcop. deploy.sh creates it from this
# file once. Plain KEY=VALUE lines (systemd's EnvironmentFile form); no quotes, no spaces around "=".

# The IPv4 address players reach this host at: the directory hands it out as the firewall
# detector's address. Required; the service refuses to start without it.
#SFCOP_PUBLIC_ADDRESS=

# The directory itself, on the original's port, and the firewall detector it hands out.
SFCOP_DIRECTORY_LISTEN=0.0.0.0:15101
SFCOP_DETECTOR_LISTEN=0.0.0.0:15102

# The campaign servers the directory lists (server/directory/README.md, "The campaign file"),
# and the directory path the client asks for them under (its server setup file's ServerPath).
SFCOP_CAMPAIGN_FILE=/etc/sfcop/campaigns.txt
#SFCOP_CAMPAIGN_PATH=/StarFleetCommand2/Game/Release

# The health endpoint for the host's monitor, never public.
SFCOP_HEALTH_LISTEN=127.0.0.1:47713

# What the host's monitor runs once when a health check starts failing; it may use
# $SFCOP_ALERT_MESSAGE. The owner's channel goes here and nowhere else.
#SFCOP_ALERT_COMMAND=curl -fsS -d "$SFCOP_ALERT_MESSAGE" https://ntfy.example.test/your-topic

# debug adds one line per malformed request.
#SFCOP_LOG_LEVEL=info
