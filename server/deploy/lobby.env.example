# /etc/sfcop/lobby.env: the lobby's configuration. Outside the repository, mode 640, owner
# root:sfcop. deploy.sh creates it from this file once.
# Plain KEY=VALUE lines (systemd's EnvironmentFile form); no quotes, no spaces around "=".

# The ticket key (SFCOP_TICKET_KEY, 64 hex digits) is NOT here: it is shared with the relay and
# lives in /etc/sfcop/sfcop.env (mode 600), which the unit reads too (RENDEZVOUS.md, "Tickets").

# The lobby API, plain HTTP behind the host's TLS proxy (server/README.md). Loopback only.
SFCOP_HTTP_LISTEN=127.0.0.1:8080

# The same API for the host's own monitor, never public. (47711 is the relay's.)
SFCOP_HEALTH_LISTEN=127.0.0.1:47712

# The relay's name and UDP port, which clients are told to bind at, and its loopback HTTP port,
# where the lobby tells it a session is gone. Set the host to the DNS name or IPv4 address players
# can reach.
SFCOP_RENDEZVOUS_HOST=lobby.example.test
#SFCOP_RELAY_PORT=47710
#SFCOP_RELAY_HEALTH_PORT=47711

# Addresses to refuse, comma separated (IPv4). Changing it needs a service restart.
#SFCOP_BLOCKLIST=

# What the host's monitor runs once when a health check starts failing; it may use
# $SFCOP_ALERT_MESSAGE. The owner's channel goes here and nowhere else, for example:
#SFCOP_ALERT_COMMAND=curl -fsS -d "$SFCOP_ALERT_MESSAGE" https://ntfy.example.test/your-topic

# debug adds the lines that name no address either, but are chatty.
#SFCOP_LOG_LEVEL=info
