# /etc/sfcop/relay.env: the relay's configuration. Outside the repository, mode 640, owner
# root:sfcop. deploy.sh creates it from this file once.
# Plain KEY=VALUE lines (systemd's EnvironmentFile form); no quotes, no spaces around "=".

# The ticket key (SFCOP_TICKET_KEY, 64 hex digits) is NOT here: it is shared with the lobby and
# lives in /etc/sfcop/sfcop.env (mode 600), which the unit reads too (RENDEZVOUS.md, "Tickets").

# The UDP port clients bind at and send envelopes to. Keep it equal to SFCOP_RELAY_PORT in lobby.env,
# which tells clients where to go. Default: 47710.
#SFCOP_RELAY_PORT=47710

# The relay's loopback HTTP listener: the health endpoint, and the call the lobby makes when it
# removes a session. The host's monitor reads the same name. Keep the port equal to
# SFCOP_RELAY_HEALTH_PORT in lobby.env. Loopback only.
SFCOP_HEALTH_LISTEN=127.0.0.1:47711

# What the host's monitor runs once when a health check starts failing; it may use
# $SFCOP_ALERT_MESSAGE. The owner's channel goes here and nowhere else.
#SFCOP_ALERT_COMMAND=curl -fsS -d "$SFCOP_ALERT_MESSAGE" https://ntfy.example.test/your-topic

# debug adds the lines that name addresses (rate-limit and block events); chatty.
#SFCOP_LOG_LEVEL=info
