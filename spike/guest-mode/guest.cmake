# The guest-mode spike's build (C3, DESIGN §12.4): the SFCOP_GUEST_MODE option, prototyped
# outside the build's own files, which are not this package's.
#
#   cmake --preset macos-arm64 -DCMAKE_PROJECT_INCLUDE=<repo>/spike/guest-mode/guest.cmake \
#         [-DSFCOP_GUEST_MODE=ON] -DSFCOP_OBJLIFT=OFF
#
# SFCOP_OBJLIFT (cmake/lifter/objlift.cmake) replaces the same bodies, so both builds set it OFF.
#
# CMake reads this file inside the top-level project() call; the work is deferred to the end of the
# top-level CMakeLists.txt, when sfcop, sfcop_src and sfcop_lifted exist. Then:
#
# - always: sfcop_guest_test, the spike's guest test (spike/guest-mode/guest_test.c), linked like
#   sfcop;
# - with SFCOP_GUEST_MODE=ON:
#   1. the claimed units of game/manifest.tsv (mode "guest") and src/app/guest/override.cpp are
#      compiled in guest mode into sfcop_guest (override.cpp leaves sfcop_src, which would
#      otherwise build its empty table);
#   2. every lifted file is compiled with a generated header that declares the claimed functions'
#      lifted bodies weak (`#pragma weak sub_006FC5A0`). A weak body is neither inlined into its
#      callers nor kept by the linker against a strong definition, so override.cpp's entry points
#      replace it for the lift's direct calls, its dispatch table and every guest vtable slot;
#   3. sfcop and sfcop_guest_test link sfcop_guest.
#
# What folding this into the build means is in spike/guest-mode/REPORT.md ("Build").
include_guard(GLOBAL)

option(SFCOP_GUEST_MODE "Compile the functions claimed in game/ in guest mode into sfcop" OFF)

function(_sfcop_guest_setup)
    if(NOT TARGET sfcop_lifted OR NOT TARGET sfcop_boot)
        message(STATUS "guest-mode spike: no lifted build here (SFCOP_LIFT off or not ready); nothing added")
        return()
    endif()
    set(_root "${CMAKE_SOURCE_DIR}")
    set(_gen "${CMAKE_BINARY_DIR}/generated/guest")
    get_target_property(_recomp_defs sfcop_boot COMPILE_DEFINITIONS)
    get_target_property(_recomp_incs sfcop_boot INCLUDE_DIRECTORIES)

    if(SFCOP_GUEST_MODE)
        # The manifest and override table in the tree must be what the annotations give.
        execute_process(
            COMMAND "${Python3_EXECUTABLE}" "${_root}/tools/manifest.py" --check
            RESULT_VARIABLE _rc ERROR_VARIABLE _err)
        if(NOT _rc EQUAL 0)
            message(FATAL_ERROR "SFCOP_GUEST_MODE: ${_err}")
        endif()
        file(STRINGS "${_root}/game/manifest.tsv" _rows)
        set(_units "")
        set(_weak "/* Generated by spike/guest-mode/guest.cmake from game/manifest.tsv. */\n")
        foreach(_row IN LISTS _rows)
            string(REPLACE "\t" ";" _f "${_row}")
            list(GET _f 0 _address)
            list(GET _f 3 _unit)
            list(GET _f 4 _modes)
            if(_address STREQUAL "address" OR NOT _modes MATCHES "guest")
                continue()
            endif()
            string(SUBSTRING "${_address}" 2 -1 _hex)
            string(TOUPPER "${_hex}" _hex)
            string(APPEND _weak "#pragma weak sub_${_hex}\n")
            list(APPEND _units "${_root}/game/${_unit}")
        endforeach()
        list(REMOVE_DUPLICATES _units)
        file(WRITE "${_gen}/weak_claimed.h" "${_weak}")
        configure_file("${_root}/game/manifest.tsv" "${_gen}/manifest.tsv" COPYONLY)

        # 1. guest mode: the same source, clang, game/port/types.h first
        set(_override "${_root}/src/app/guest/override.cpp")
        # override.cpp moves from the sfcop_src archive to an object library: an archive member is
        # never loaded to replace a symbol that is already defined, even weakly.
        get_target_property(_src_sources sfcop_src SOURCES)
        list(REMOVE_ITEM _src_sources "${_override}")
        if(NOT _src_sources)
            file(WRITE "${_gen}/sfcop_src_placeholder.cpp" "// sfcop_src had only override.cpp.\n")
            set(_src_sources "${_gen}/sfcop_src_placeholder.cpp")
        endif()
        set_property(TARGET sfcop_src PROPERTY SOURCES ${_src_sources})
        add_library(sfcop_guest OBJECT ${_units} "${_override}")
        target_include_directories(sfcop_guest PRIVATE "${_root}/game" "${_root}/game/port" "${_root}/src")
        # SFCOP_GUEST_BASE is the lift's RECOMP_MEM_BASE: guest address 0 in the host.
        set(_base "")
        foreach(_d IN LISTS _recomp_defs)
            if(_d MATCHES "^RECOMP_MEM_BASE=(.*)$")
                set(_base "${CMAKE_MATCH_1}")
            endif()
        endforeach()
        if(_base STREQUAL "")
            message(FATAL_ERROR "SFCOP_GUEST_MODE: the lift defines no RECOMP_MEM_BASE")
        endif()
        target_compile_definitions(sfcop_guest PRIVATE SFCOP_GUEST SFCOP_GUEST_MODE_SOURCES
            "SFCOP_GUEST_BASE=${_base}")
        # -fno-access-control: the generated entry points name private members and nested classes,
        # as the original's own code may. game/ builds with warnings allowed (CONVENTIONS §1).
        target_compile_options(sfcop_guest PRIVATE -fms-extensions -fno-access-control
            -include "${_root}/game/port/types.h" -w)

        # 2. the claimed lifted bodies, weak
        target_compile_options(sfcop_lifted PRIVATE -include "${_gen}/weak_claimed.h")

        # 3.
        target_link_libraries(sfcop PRIVATE sfcop_guest)
        list(LENGTH _units _n)
        message(STATUS "guest-mode spike: SFCOP_GUEST_MODE on, ${_n} unit(s) in guest mode")
    endif()

    add_executable(sfcop_guest_test "${_root}/spike/guest-mode/guest_test.c")
    target_include_directories(sfcop_guest_test PRIVATE ${_recomp_incs} "${_root}/src")
    target_compile_definitions(sfcop_guest_test PRIVATE ${_recomp_defs})
    target_compile_options(sfcop_guest_test PRIVATE -fno-strict-aliasing -fwrapv)
    target_link_libraries(sfcop_guest_test PRIVATE sfcop_src sfcop_boot sfcop_win32hle sfcop_lifted
        SDL2::SDL2 pthread m)
    if(TARGET sfcop_hle_guest)   # the HLE modules' shim tables, which the registration names
        target_link_libraries(sfcop_guest_test PRIVATE sfcop_hle_guest)
    endif()
    if(SFCOP_GUEST_MODE)
        target_link_libraries(sfcop_guest_test PRIVATE sfcop_guest)
    endif()
    add_dependencies(sfcop_guest_test SDL3-shared)
endfunction()

cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _sfcop_guest_setup)
